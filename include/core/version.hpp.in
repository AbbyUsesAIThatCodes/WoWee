#pragma once

// Generated from git at build time - see cmake/GitVersion.cmake.
// Normal builds use the last reachable tag; fork reviews use one immutable
// manifest reserved before compilation (docs/BUILD_IDENTITY.md).

namespace wowee {
namespace core {

inline constexpr const char* kVersion = "@WOWEE_GIT_VERSION@";
inline constexpr const char* kBuildDate = "@WOWEE_BUILD_DATE@";

// The login screen and settings share this exact generated identity.
inline constexpr const char* kVersionString = "@WOWEE_BUILD_ID@";
inline constexpr bool kIsReviewBuild = @WOWEE_IS_REVIEW@;

} // namespace core
} // namespace wowee
